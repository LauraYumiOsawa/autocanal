conteudo:
  nome: Conteúdo
  nicho: ""
  idioma: pt-BR
  categoria_id: "27"
  paleta: {fundo: "#0F172A", texto: "#F8FAFC", destaque: "#FACC15"}
  tts: {provedor: google, voz: pt-BR-Chirp3-HD-Charon, reserva: kokoro, voz_reserva: pm_alex}
  fonte_arquivo: /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf
  fonte_nome: DejaVu Sans
  perfil_voz: config/vozes/exemplo.md
  # opcionais (padrões entre parênteses):
  feito_para_criancas: false  # (false) marca o upload como conteúdo infantil
  visuais: [pixabay, flux]  # ([pixabay]) fontes na ordem; o procedural só existe para emergência
  estilo_visual: realista  # (realista) ou desenho: vale para o Pixabay e para o FLUX
  estilo_ia: ""  # ("") texto extra no prompt do FLUX, em inglês (ex.: "warm cinematic tones")
  grade:
    - {formato: short, dias: [seg, qua, sex, dom], hora: "12:00"}
    - {formato: short, dias: [ter, qui, sab], hora: "19:00"}
    - {formato: medio, dias: [ter, qui], hora: "18:00"}
